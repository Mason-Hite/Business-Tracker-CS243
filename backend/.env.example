# ===========================================
# Business-Tracker Environment Variables
# Copy this file to .env and fill in real values
# ===========================================

PORT=5000

# --- Database Mode ---
# Set to "sqlite" for easy free hosting on Render (recommended for demo)
# Set to "mysql" (or leave unset) to use MySQL (for local Docker or full hosting)
DB_TYPE=sqlite

# --- SQLite Settings (used when DB_TYPE=sqlite) ---
DB_PATH=./data/business_tracker.db

# --- MySQL Settings (used when DB_TYPE=mysql or not set) ---
DB_HOST=localhost
DB_PORT=3307
DB_USER=user
DB_PASSWORD=pass
DB_NAME=business_tracker

GROQ_API_KEY=Get key at https://console.groq.com/keys